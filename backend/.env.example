PROJECT_NAME=COGNISEC-AI
ENVIRONMENT=development
API_V1_STR=/api
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL: Supports PostgreSQL (e.g. Neon PostgreSQL) or SQLite
# Neon / Cloud PostgreSQL Connection String:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
# Local SQLite fallback:
# DATABASE_URL=sqlite:///./cognisec.db

# CORS Allowed Origins (Explicit origins, NO wildcard '*' with credentials)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5500","http://127.0.0.1:3000","http://127.0.0.1:5500","http://localhost:8000","http://127.0.0.1:8000"]

# Bootstrap Secret for Controlled Development/Admin Provisioning
BOOTSTRAP_ADMIN_KEY=your-dev-bootstrap-key-here

# Risk Engine Policy Thresholds
RISK_THRESHOLD_LOW=0.30
RISK_THRESHOLD_MEDIUM=0.65
RISK_THRESHOLD_HIGH=0.85

# SMTP / Real Email Delivery Configuration (Gmail SMTP / SendGrid / AWS SES)
# NOTE: For Gmail, you MUST enable 2-Step Verification on your Google Account and generate
# a 16-character Google App Password (https://myaccount.google.com/apppasswords).
# NEVER use your standard Gmail account password. Keep SMTP_ENABLED=false until configured.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cognisecai.security@gmail.com
SMTP_PASSWORD=your-google-app-password-here
SMTP_FROM=cognisecai.security@gmail.com
SMTP_FROM_NAME="COGNISEC-AI Security"
SMTP_TLS=true
SMTP_TIMEOUT_SECONDS=15
SMTP_ENABLED=false
APP_BASE_URL=http://127.0.0.1:5500

# Exhibition Mode: Set to false in production. When false, OTP is NEVER returned in API responses.
# When true (development demo only), OTP is also displayed in the UI callout for demonstration.
EXHIBITION_MODE=false
